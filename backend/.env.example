# Локальний PostgreSQL, установлений без Docker
# Створіть .env і вкажіть особисті значення (не публікуйте цей файл)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/bookshop
# Generate TWO distinct secrets locally with: python -m app.generate_keys
# NEVER commit backend/.env. Keep these keys stable after adding users.
DATA_ENCRYPTION_KEY=PASTE_GENERATED_VALUE_HERE
EMAIL_LOOKUP_KEY=PASTE_DIFFERENT_GENERATED_VALUE_HERE
